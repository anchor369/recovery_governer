PGHOST=localhost
PGPORT=5432
PGDATABASE=razorpay_recovery
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Optional bounded connection-pool settings.
PGPOOL_MIN_SIZE=1
PGPOOL_MAX_SIZE=5
PGPOOL_TIMEOUT=30

# Streamlit connects to FastAPI exclusively over HTTP.
RECOVERY_API_BASE_URL=http://127.0.0.1:8000
RECOVERY_API_TIMEOUT=30
